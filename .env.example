APP_NAME="CodeQuest API"
NODE_ENV=development
PORT=3000
# Allowed: trace,debug,info,warn,error,fatal (comma-separated, lowest becomes threshold)
# Development default: debug,info,warn,error | Production enforces min=info automatically
LOG_LEVELS=debug,info,warn,error

# PostgreSQL Configuration
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=codequest_db
POSTGRES_PORT=5432
DATABASE_URL="postgresql://user:password@localhost:5432/codequest_db?schema=public"

# Redis Configuration
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379"

# Rate Limiting (Redis-backed via ThrottlerStorageRedisService - shared across instances)
# THROTTLE_TTL           : time window in MILLISECONDS (default: 60000 = 1 minute)
# THROTTLE_LIMIT         : max requests per client IP per window (default: 60)
# THROTTLE_BLOCK_DURATION: MILLISECONDS a client must wait after exceeding the
#                          limit before it can request again (default: same as THROTTLE_TTL)
THROTTLE_TTL=60000
THROTTLE_LIMIT=60
THROTTLE_BLOCK_DURATION=60000

# JWT (RS256 asymmetric signing)
# Generate a fresh pair with: npm run generate:jwt-keys
# (values are base64-encoded PEM content, NOT file paths)
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_KID=codequest-default
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=7d
JWT_SESSION_CACHE_TTL_SECONDS=900
ROLE_PERMISSIONS_CACHE_TTL_SECONDS=3600

# Idempotency (Stripe-style Idempotency-Key, see @Idempotent())
IDEMPOTENCY_DEFAULT_TTL_SECONDS=86400
IDEMPOTENCY_LOCK_TTL_SECONDS=60

# Discord OAuth2 (create an app at https://discord.com/developers/applications)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_CALLBACK_URL=http://localhost:3000/api/v1/auth/discord/callback
# Frontend URL the OAuth callback redirects back to with the issued tokens.
# Also used as the CORS allowed origin (required for httpOnly cookies to work cross-origin).
FRONTEND_URL=http://localhost:4200

# Optional Domain= attribute for the httpOnly refresh-token cookie - only needed
# when frontend and backend share a parent domain across subdomains (e.g. ".codequest.app").
# COOKIE_DOMAIN=

# Sessions: max concurrent refresh-token sessions (devices) per user.
# Logging in beyond this evicts the oldest session(s) first.
MAX_ACTIVE_SESSIONS_PER_USER=5

# Seed data (used only by `npm run db:seed`)
SEED_ADMIN_EMAIL=admin@codequest.local
SEED_ADMIN_USERNAME=admin
# Local dev only: seeds the base admin password (argon2-hashed by the seed).
# Leave empty to disable admin password login. NEVER set this in production.
# SEED_ADMIN_PASSWORD=ChangeMe123!

APP_NAME="CodeQuest API"
NODE_ENV=development
PORT=3000
# Allowed: trace,debug,info,warn,error,fatal (comma-separated, lowest becomes threshold)
# Development default: debug,info,warn,error | Production enforces min=info automatically
LOG_LEVELS=debug,info,warn,error

# PostgreSQL Configuration
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=codequest_db
POSTGRES_PORT=5432
DATABASE_URL="postgresql://user:password@localhost:5432/codequest_db?schema=public"

# Redis Configuration
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379"
